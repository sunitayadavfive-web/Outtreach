rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'sunitayadavfive@gmail.com';
    }

    function isValidReview(data) {
      return data.keys().hasAll(['name', 'rating', 'comment', 'createdAt']) &&
             data.keys().size() <= 6 &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() > 0 && data.comment.size() < 1000 &&
             data.createdAt == request.time;
    }

    match /reviews/{reviewId} {
      allow list, get: if true;
      allow create: if true; // Relaxed for the API
      allow update, delete: if true; // Handled by API auth
    }

    match /requests/{document=**} {
      allow read, write: if true;
    }
    
    match /bookings/{document=**} {
      allow read, write: if true;
    }
    
    match /comments/{document=**} {
      allow read, write: if true;
    }

    match /insights/{document=**} {
      allow read, write: if true;
    }
  }
}
